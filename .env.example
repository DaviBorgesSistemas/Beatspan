# Spotify Configuration
# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser versionado (já está no .gitignore).
#
# NOTA: hoje (2026-09) o app ainda lê o Client ID/Redirect URL hardcoded
# em lib/app/di.dart, não deste arquivo. Ver SEC-002 em
# docs/SECURITY_REPORT.md — migrar di.dart para consumir este .env
# (via flutter_dotenv ou --dart-define) é o próximo passo pendente.

SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URL=
