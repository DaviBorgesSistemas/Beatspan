# Spotify Configuration
# Copie este arquivo para .env e preencha com valores reais.
#
# O app carrega este arquivo via flutter_dotenv em tempo de execução
# (ver lib/main.dart e lib/app/di.dart). Sem SPOTIFY_CLIENT_ID e
# SPOTIFY_REDIRECT_URL definidos, initAppModule() lança um erro claro
# na inicialização.

SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URL=
